# Application
NODE_ENV=development
APP_NAME=pwa-torneios
APP_PORT=3000
APP_URL=http://localhost

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=competitions
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/competitions?schema=public

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=change-me-in-local-env
JWT_REFRESH_SECRET=change-me-too-in-local-env
CORS_ORIGINS=http://app.localhost,http://localhost:3001
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Object storage
S3_REGION=us-east-1
S3_BUCKET=intereng
S3_ACCESS_KEY_ID=intereng
S3_SECRET_ACCESS_KEY=intereng-local-secret
S3_PRESIGN_TTL_SECONDS=300
S3_MAX_LOGO_BYTES=8388608

# Front-end (apps/web)
# local = estado no navegador (padrão, usado pelos e2e); http = API
NEXT_PUBLIC_DATA_SOURCE=http
NEXT_PUBLIC_API_URL=http://api.localhost/api/v1

# Traefik / Local routing
TRAEFIK_DASHBOARD_PORT=8080
API_HOST=api.localhost
WEB_HOST=app.localhost

# Logs
LOG_LEVEL=debug
