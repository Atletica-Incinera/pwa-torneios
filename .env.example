# Application
NODE_ENV=development
APP_NAME=pwa-torneios
APP_PORT=3000
APP_URL=http://localhost

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pwa_torneios
POSTGRES_USER=pwa_torneios
POSTGRES_PASSWORD=pwa_torneios_dev
DATABASE_URL=postgresql://pwa_torneios:pwa_torneios_dev@postgres:5432/pwa_torneios

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=change-me-in-local-env
JWT_REFRESH_SECRET=change-me-too
# PII da API (atleta), com hash e pepper
PII_PEPPER=change-me-pepper
PII_ENCRYPTION_KEY=change-me-key

# Front-end (apps/web)
# Embutidos na compilação: mudar exige rebuild da imagem.
# local = estado no navegador (padrão, usado pelos e2e); http = API
NEXT_PUBLIC_DATA_SOURCE=local
# Mesmo host do app, roteado pelo Traefik — evita CORS e cookie cross-site
NEXT_PUBLIC_API_URL=/api/v1
# sse (padrão) | poll (ponte até a API ter stream por edição) | off
NEXT_PUBLIC_REALTIME=sse
# Milissegundos entre releituras do snapshot quando o modo é `poll`. Ignorado
# pelos outros dois.
NEXT_PUBLIC_REALTIME_INTERVAL=5000

# API (outro repositório: Atletica-Incinera/intereng-api)
# Checkout ao lado desta árvore, nunca dentro dela
API_REPO_PATH=../intereng-api
API_IMAGE=ghcr.io/atletica-incinera/intereng-api:main
CORS_ORIGINS=http://app.localhost
# Gancho de reset para a suíte de integração. Nunca em produção.
ENABLE_TEST_ENDPOINTS=false

# Traefik / Local routing
TRAEFIK_DASHBOARD_PORT=8080
API_HOST=api.localhost
WEB_HOST=app.localhost

# Logs
LOG_LEVEL=debug
