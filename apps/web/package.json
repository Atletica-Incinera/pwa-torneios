{
  "name": "pwa-torneios-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --no-warnings --test tests/unit/sound-effects.test.ts",
    "test:components": "vitest run",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "test:visual:update": "npm run build && node scripts/run-e2e.mjs --grep \"regressão visual\" --update-snapshots",
    "test:e2e:http": "node scripts/build-http.mjs && node scripts/run-e2e-http.mjs",
    "test:e2e:api": "node scripts/run-e2e-api.mjs"
  },
  "dependencies": {
    "@atletica-incinera/intereng-contract": "0.1.0",
    "@fontsource-variable/host-grotesk": "5.2.8",
    "@fontsource/boldonse": "5.2.4",
    "lucide-react": "1.24.0",
    "next": "16.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
